###############################################################################
# NexHRIS — environment
#
# Copy to .env on the server and fill in. Every value below is read somewhere
# in the app; nothing here is decoration.
#
# After editing on the server, always run:
#   php artisan config:cache
# The app reads settings through config(), not env(), so a change without this
# will not take effect.
###############################################################################

APP_NAME="NexHRIS"

# production turns off development tooling; local re-enables it.
APP_ENV=production

# php artisan key:generate --force   (once, on the server — do not copy a key)
APP_KEY=

# MUST be false in production. True prints stack traces, the database name and
# the contents of this file to anyone who triggers an error.
APP_DEBUG=false

# The real address, with https. Password-reset and notification links are built
# from this, so a wrong value emails people a dead URL.
APP_URL=https://hris.example.ph

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# debug fills a shared-hosting disk quota.
LOG_LEVEL=warning

###############################################################################
# Database — from the hosting control panel
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

###############################################################################
# Sessions
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# Leave as null unless the site is on a subdomain that must share the session.
SESSION_DOMAIN=null

# Only once the domain actually serves https, or nobody can sign in.
SESSION_SECURE_COOKIE=true

###############################################################################
# Queue, cache, storage
#
# Nothing in the app is queued or scheduled, so there is no worker to keep
# alive and no cron entry to add. Mail is sent inside the request that
# triggers it.
###############################################################################
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

###############################################################################
# Mail — the address employees see notifications come from
#
# Gmail will not accept an account password here. On the HR mailbox:
#   1. Turn on 2-Step Verification (myaccount.google.com/security)
#   2. Create an App Password (myaccount.google.com/apppasswords)
#   3. Paste the 16 characters below, no spaces
#
# MAIL_USERNAME must be the same mailbox as MAIL_FROM_ADDRESS, or Gmail
# rewrites the sender and replies go to the wrong inbox — silently.
#
# Verify after deploying:  php artisan mail:test someone@example.com
###############################################################################
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=hr.tagudin@ispsc.edu.ph
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hr.tagudin@ispsc.edu.ph"
MAIL_FROM_NAME="ISPSC Tagudin HR Office"

###############################################################################
# Two-factor sign-in
#
# Emails a code at sign-in to the HR Administrator, the Deans and the Campus
# Director. Ordinary employees are never challenged.
#
# It depends entirely on the mail settings above: if the code cannot be sent,
# those accounts cannot sign in, and there is no bypass code. Deploy with this
# false, prove `mail:test` delivers, then switch it on.
###############################################################################
TWO_FACTOR_ENABLED=false

###############################################################################
# PDF conversion
#
#   auto  LibreOffice when the binary is present, otherwise the PHP renderer
#   php   always the PHP renderer — for hosting with no shell access
#
# Both convert the workbook the employee actually uploaded. LibreOffice is the
# reference: it is what the campus forms were laid out against, so leave this
# on auto wherever LibreOffice can be installed.
#
# On a VPS:
#
#   sudo apt install libreoffice-calc fonts-liberation
#   which soffice          # usually /usr/bin/soffice
#
# The path below is optional — the usual install locations are searched — but
# set it if soffice lives somewhere unusual. Note the variable name: this is
# the one the application reads, and a stray SOFFICE_PATH does nothing.
#
# LibreOffice is run headless with a private profile per conversion, so it
# needs no writable home directory and concurrent conversions do not collide.
# It does need PHP's proc_open, which some shared hosts disable; where that is
# the case, set PDF_RENDERER=php instead.
###############################################################################
PDF_RENDERER=auto
# LIBREOFFICE_PATH=/usr/bin/soffice

###############################################################################
# Backups
#
#   php artisan backup:run
#
# Writes an AES-256 encrypted archive of the database and every uploaded record
# to storage/app/backups. Set a long BACKUP_PASSWORD and keep it somewhere
# other than this server — an encrypted archive whose password sits beside it
# protects nothing if the server is what was lost.
#
# BACKUP_DISK copies each archive off-site. It needs the S3 adapter, which is
# not installed by default because it pulls in the whole AWS SDK:
#     composer require league/flysystem-aws-s3-v3
###############################################################################
BACKUP_PASSWORD=
BACKUP_KEEP=7
# BACKUP_DISK=s3

VITE_APP_NAME="${APP_NAME}"
